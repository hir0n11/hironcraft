<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <Script file="RecipeConfigPanel.lua" />

    <Frame name="HironCraftScanRecipeConfigPanelTemplate" mixin="HironCraftScanRecipeConfigPanelMixin"
        virtual="true" hidden="true">
        <Size x="750" y="575" />
        <Anchors>
            <Anchor point="TOPLEFT" y="-6" />
        </Anchors>

        <Layers>
            <Layer level="ARTWORK">
                <FontString parentKey="IconLabel" inherits="GameFontHighlightMed2" justifyV="TOP"
                    justifyH="LEFT">
                    <Size x="400" y="0" />
                    <!--
                    This isn't working for some reason. Doing it in code instead.
                    <Anchors>
                        Anchor point="LEFT" relativeKey="$parent.RecipeIcon" relativePoint="RIGHT" x="14" y="17"/> 
                    Anchors> -->
                </FontString>
                <FontString parentKey="IconSubLabel" inherits="GameFontHighlightSmall2"
                    wordwrap="true" justifyV="TOP" justifyH="LEFT">
                    <Size x="392" y="60" />
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.IconLabel"
                            relativePoint="BOTTOMLEFT" y="-3" />
                    </Anchors>
                </FontString>

            </Layer>
        </Layers>

        <Frames>
            <Button parentKey="RecipeIcon" inherits="ProfessionsOutputButtonTemplate">
                <KeyValues>
                    <KeyValue key="noProfessionQualityOverlay" value="true" type="boolean" />
                </KeyValues>
                <Anchors>
                    <Anchor point="TOPLEFT" x="28" y="-33" />
                </Anchors>
            </Button>

            <Frame parentKey="Left" mixin="HironCraftScanGeneralConfigMatchingMixin">
                <Size x="350" y="265" />
                <Anchors>
                    <Anchor point="TOPLEFT" y="-80" />
                </Anchors>
                <Layers>
                    <Layer level="OVERLAY">
                        <FontString parentKey="Title" inherits="GameFontNormal" justifyH="LEFT">
                            <Size y="25" />
                            <Anchors>
                                <Anchor point="TOP" y="-5" />
                                <Anchor point="LEFT" x="10" />
                                <Anchor point="RIGHT" x="-10" />
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
                <Frames>
                    <Frame parentKey="Keywords" inherits="HironCraftScanTextInputTemplate">
                        <Size x="335" y="80" />
                        <Anchors>
                            <Anchor point="TOP" relativeKey="$parent.Title" relativePoint="BOTTOM" />
                            <Anchor point="LEFT" x="5" />
                        </Anchors>
                    </Frame>
                    <Frame parentKey="SecondaryKeywords" inherits="HironCraftScanTextInputTemplate">
                        <Size x="335" y="80" />
                        <Anchors>
                            <Anchor point="TOPLEFT" relativeKey="$parent.Keywords"
                                relativePoint="BOTTOMLEFT" />
                        </Anchors>
                    </Frame>
                    <Frame parentKey="Commission" inherits="HironCraftScanTextInputTemplate">
                        <Size x="335" y="55" />
                        <Anchors>
                            <Anchor point="TOPLEFT" relativeKey="$parent.SecondaryKeywords"
                                relativePoint="BOTTOMLEFT" />
                        </Anchors>
                    </Frame>
                    <Frame parentKey="RequiredConcentration" inherits="HironCraftScanSliderTemplate">
                        <Size x="335" y="43" />
                        <Anchors>
                            <Anchor point="TOPLEFT" relativeKey="$parent.Commission"
                                relativePoint="BOTTOMLEFT" />
                        </Anchors>
                    </Frame>
                </Frames>
            </Frame>
            <Frame parentKey="Right" mixin="HironCraftScanGreetingConfigPanelMixin">
                <Size x="375" y="250" />
                <Anchors>
                    <Anchor point="TOPRIGHT" y="-80" />
                </Anchors>
                <Layers>
                    <Layer level="OVERLAY">
                        <FontString parentKey="Title" inherits="GameFontNormal" justifyH="LEFT">
                            <Size y="25" />
                            <Anchors>
                                <Anchor point="TOP" y="-5" />
                                <Anchor point="LEFT" x="10" />
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
                <Frames>
                    <Frame parentKey="Greeting" inherits="HironCraftScanTextInputTemplate">
                        <Size x="335" y="80" />
                        <Anchors>
                            <Anchor point="TOPLEFT" relativeKey="$parent.Title"
                                relativePoint="BOTTOMLEFT" x="-5" />
                        </Anchors>
                    </Frame>
                    <Frame parentKey="OmitGeneral" inherits="HironCraftScanCheckButtonTemplate">
                        <Anchors>
                            <Anchor point="TOPLEFT" relativeKey="$parent.Greeting"
                                relativePoint="BOTTOMLEFT" />
                        </Anchors>
                    </Frame>
                    <Frame parentKey="OmitProfession" inherits="HironCraftScanCheckButtonTemplate">
                        <Anchors>
                            <Anchor point="TOPLEFT" relativeKey="$parent.OmitGeneral"
                                relativePoint="BOTTOMLEFT" />
                        </Anchors>
                    </Frame>
                </Frames>
            </Frame>
            <Button parentKey="EnableScanning" inherits="HironCraftScanConfigButtonTemplate" />
            <Button parentKey="DisableScanning" inherits="HironCraftScanConfigButtonTemplate" />
            <Button parentKey="PendingReview" inherits="HironCraftScanConfigButtonTemplate" />
            <Button parentKey="EnableAll" inherits="HironCraftScanConfigButtonTemplate" />
        </Frames>

    </Frame>

</Ui>