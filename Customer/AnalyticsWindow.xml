<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

	<Script file="AnalyticsWindow.lua"/>

	<!-- One line of the analytics tables; its cells are made in Lua. -->
	<Button name="HironCraftAnalyticsRowTemplate" registerForClicks="LeftButtonUp, RightButtonUp" virtual="true">
		<Size y="20"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Stripe" setAllPoints="true" hidden="true">
					<Color r="1" g="1" b="1" a="0.035"/>
				</Texture>
			</Layer>
			<Layer level="HIGHLIGHT">
				<Texture parentKey="Highlight" atlas="auctionhouse-ui-row-highlight" alphaMode="ADD" setAllPoints="true"/>
			</Layer>
		</Layers>
	</Button>
</Ui>
