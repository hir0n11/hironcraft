<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

	<Script file="AnalyticsTableTemplate.lua"/>

	<Frame name="HironCraftScanAnalyticsCellItemNameTemplate" mixin="HironCraftScanAnalyticsCellItemNameMixin" virtual="true">
		<Size x="0" y="16"/>
		<Layers>
			<Layer level="BACKGROUND" textureSubLevel="1">
				<Texture parentKey="Icon">
					<Size x="14" y="14"/>
					<Anchors>
						<Anchor point="LEFT"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="BACKGROUND" textureSubLevel="2">
				<Texture parentKey="IconBorder" atlas="auctionhouse-itemicon-small-border" useAtlasSize="false">
					<Size x="16" y="16"/>
					<Anchors>
						<Anchor point="CENTER" relativeKey="$parent.Icon"/>
					</Anchors>
				</Texture>

				<FontString parentKey="Text" inherits="Number14FontWhite" justifyH="LEFT" maxLines="1">
					<Size x="0" y="1"/>
					<Anchors>
						<Anchor point="LEFT" relativeKey="$parent.Icon" relativePoint="RIGHT" x="4" y="-1"/>
						<Anchor point="RIGHT" x="1"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
	</Frame>
	<Frame name="HironCraftScanAnalyticsTableCellProfessionNameTemplate" mixin="HironCraftScanAnalyticsTableCellProfessionNameMixin" inherits="HironCraftScanTableCellTextTemplate" virtual="true"/>
	<Frame name="HironCraftScanAnalyticsTableCellTotalSeenTemplate" mixin="HironCraftScanAnalyticsTableCellTotalSeenMixin" inherits="HironCraftScanTableCellTextTemplate" virtual="true"/>
	<Frame name="HironCraftScanAnalyticsTableCellTotalSeenFilteredTemplate" mixin="HironCraftScanAnalyticsTableCellTotalSeenFilteredMixin" inherits="HironCraftScanTableCellTextTemplate" virtual="true"/>
	<Frame name="HironCraftScanAnalyticsTableCellAveragePerDayTemplate" mixin="HironCraftScanAnalyticsTableCellAveragePerDayMixin" inherits="HironCraftScanTableCellTextTemplate" virtual="true"/>
	<Frame name="HironCraftScanAnalyticsTableCellPeakPerHourTemplate" mixin="HironCraftScanAnalyticsTableCellPeakPerHourMixin" inherits="HironCraftScanTableCellTextTemplate" virtual="true"/>
	<Frame name="HironCraftScanAnalyticsTableCellMedianPerCustomerTemplate" mixin="HironCraftScanAnalyticsTableCellMedianPerCustomerMixin" inherits="HironCraftScanTableCellTextTemplate" virtual="true"/>
	<Frame name="HironCraftScanAnalyticsTableCellMedianPerCustomerFilteredTemplate" mixin="HironCraftScanAnalyticsTableCellMedianPerCustomerFilteredMixin" inherits="HironCraftScanTableCellTextTemplate" virtual="true"/>

	<Button name="HironCraftScanAnalyticsTableHeaderStringTemplate" mixin="HironCraftScanAnalyticsTableHeaderStringMixin" inherits="ColumnDisplayButtonShortTemplate" virtual="true">
		<Size x="0" y="19"/>
		<Layers>
			<Layer level="OVERLAY">
				<Texture parentKey="Arrow" atlas="auctionhouse-ui-sortarrow" useAtlasSize="true">
					<Anchors>
						<Anchor point="LEFT" relativeKey="$parent.Text" relativePoint="RIGHT" x="3" y="0"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Scripts>
			<OnClick method="OnClick"/>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
		</Scripts>
	</Button>
</Ui>
